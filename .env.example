# ── AI 问答系统 v2 环境变量 ────────────────────────────
# 复制为 .env 并按需修改

# ====== LLM 后端 ======
# "local" = 本地 transformers 模型 (Qwen2.5-1.5B, CPU/GPU)
# "api"   = 远程 API (OpenAI 兼容 — 硅基流动/DeepSeek/Groq 等)
LLM_BACKEND=local

# 本地模型配置 (LLM_BACKEND=local)
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.0
LLM_LOAD_INT8=true

# 远程 API 配置 (LLM_BACKEND=api)
# 硅基流动: https://api.siliconflow.cn/v1  (免费额度)
# DeepSeek: https://api.deepseek.com/v1
# 阿里百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
API_BASE_URL=https://api.siliconflow.cn/v1
API_KEY=sk-your-key-here
API_MODEL=Qwen/Qwen2.5-7B-Instruct
API_MAX_TOKENS=512
API_TIMEOUT=60

# ====== RAG 模式 ======
# auto | rag | retrieval
RAG_MODE=auto

# ====== 混合检索 ======
TOP_K_SEMANTIC=10
TOP_K_BM25=10
TOP_K_RETRIEVAL=3
RRF_K=60
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_QUERY_REWRITE=false

# ====== 多轮对话 ======
MAX_CONVERSATION_TURNS=5
CONVERSATION_TTL_SECONDS=3600

# ====== 服务 ======
HOST=0.0.0.0
PORT=5000

# ====== 日志 ======
LOG_LEVEL=INFO
LOG_FORMAT=pretty
